# Copy to server/.env and fill in.
# MongoDB Atlas connection string. Leave empty to run with an in-memory store (data resets on restart).
MONGODB_URI=
PORT=5000
# Comma-separated origins allowed to call the API (your Vercel URL in production).
CLIENT_ORIGIN=http://localhost:5173
# Set to production on Render so the server also serves the built React app.
NODE_ENV=development
